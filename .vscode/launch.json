{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "J-Link | rm-a-board | gnu-rm",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "device": "STM32F427II",
      "interface": "swd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/cross/arm/debug/robot_project.elf",
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/../oh-my-robot-framework/platform/bsp/vendor/STM32/STM32F4/SVD/STM32F407.svd",
      "preLaunchCommands": [
        "monitor reset halt"
      ]
    },
    {
      "name": "J-Link | rm-a-board | armclang",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "device": "STM32F427II",
      "interface": "swd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/cross/cortex-m4/debug/robot_project.elf",
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/../oh-my-robot-framework/platform/bsp/vendor/STM32/STM32F4/SVD/STM32F407.svd",
      "overrideLaunchCommands": [
        "monitor reset",
        "restore ${workspaceFolder}/build/cross/cortex-m4/debug/robot_project.hex",
        "monitor reset"
      ],
      "preLaunchCommands": [
        "monitor semihosting enable",
        "monitor semihosting breakonerror 0",
        "set mem inaccessible-by-default off"
      ]
    }
  ]
}
